<div id="<%= dom_id news %>" class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
  <h2 class="font-bold text-gray-900 text-lg mb-1"><%= news.title %></h2>
  <p class="text-gray-500 text-sm mb-3 line-clamp-2"><%= news.content %></p>
  <% if (url = safe_external_url(news.link)) %>
    <%= link_to "Ver enlace →", url, target: "_blank", rel: "noopener noreferrer", class: "text-yellow-500 font-semibold text-sm hover:underline" %>
  <% end %>
</div>
