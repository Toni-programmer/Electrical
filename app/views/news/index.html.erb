<% content_for :title, "Noticias del sector eléctrico | Electricas Rincón Valencia" %>
<% content_for :meta_description, "Información sobre electricidad, normativa, energías renovables y tarifas eléctricas. Recursos útiles para particulares y empresas en Valencia." %>

<section class="bg-yellow-400 py-20 px-6">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Noticias del sector</h1>
    <p class="text-gray-800 text-lg max-w-2xl">Información útil sobre electricidad, energías renovables y normativa.</p>
  </div>
</section>

<section class="py-12 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @news.each do |item| %>
      <% logo_image = item.image.present? && %w[news-curenergia.png news-rastreator.svg news-aprendeelectricidad.jpg].include?(item.image) %>
      <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col">
        <div class="relative h-36 overflow-hidden <%= logo_image ? 'bg-gray-50' : 'bg-gray-100' %>">
          <% if item.image.present? %>
            <%= image_tag item.image,
                  alt: item.title,
                  class: "w-full h-full #{logo_image ? 'object-contain p-4' : 'object-cover group-hover:scale-105 transition-transform duration-300'}" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center">
              <svg class="h-12 w-12 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13 2L4.09 12.96A1 1 0 005 14.5h6.5L11 22l8.91-10.96A1 1 0 0019 9.5h-6.5L13 2z"/>
              </svg>
            </div>
          <% end %>
        </div>
        <div class="p-4 flex flex-col flex-1">
          <h2 class="text-sm font-bold text-gray-900 mb-2 leading-snug"><%= item.title %></h2>
          <p class="text-gray-500 text-xs mb-4 flex-1 line-clamp-3"><%= item.content %></p>
          <% if (url = safe_external_url(item.link)) %>
            <%= link_to "Ver enlace →", url, target: "_blank", rel: "noopener noreferrer",
                class: "text-yellow-500 font-semibold text-xs hover:underline self-start" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<section class="py-20 px-6 bg-gray-900 text-center">
  <h2 class="text-3xl font-bold text-white mb-4">¿Tienes alguna consulta?</h2>
  <p class="text-gray-400 mb-8 max-w-xl mx-auto">Contacta con nosotros y te asesoramos sin compromiso.</p>
  <%= link_to "Solicitar presupuesto", new_quote_path,
      class: "bg-yellow-400 text-gray-900 font-bold px-8 py-4 rounded-lg text-lg hover:bg-yellow-300 transition-colors" %>
</section>
