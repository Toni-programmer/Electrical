<% content_for :title, seo_title(@news.title) %>
<% content_for :meta_description, "#{@news.content.truncate(155)}" %>
<% content_for :og_image, @news.image if @news.image.present? %>
<% content_for :og_image_alt, @news.title %>
<% content_for :head do %>
<script type="application/ld+json">
<%== {
  "@context" => "https://schema.org",
  "@type" => "Article",
  "headline" => @news.title,
  "datePublished" => @news.created_at.iso8601,
  "dateModified" => @news.updated_at.iso8601,
  "author" => { "@type" => "Organization", "name" => "Electricas Rincón" },
  "publisher" => { "@type" => "Organization", "name" => "Electricas Rincón" }
}.to_json %>
</script>
<% end %>

<section class="bg-yellow-400 py-16 px-6">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-3"><%= @news.title %></h1>
    <time datetime="<%= @news.created_at.iso8601 %>" class="text-gray-800 font-medium text-sm">
      Publicado el <%= spanish_date(@news.created_at) %>
    </time>
  </div>
</section>

<section class="py-12 px-6">
  <div class="max-w-4xl mx-auto">
    <% if @news.image.present? %>
      <%= photo_tag @news.image, alt: @news.title, loading: "lazy", class: "w-full h-64 object-cover rounded-xl mb-8" %>
    <% end %>
    <p class="text-gray-700 leading-relaxed text-lg mb-8"><%= @news.content %></p>
    <% if (url = safe_external_url(@news.link)) %>
      <%= link_to "Ver enlace externo →", url, target: "_blank", rel: "noopener noreferrer",
          class: "inline-block bg-yellow-400 text-gray-900 font-semibold px-6 py-3 rounded-lg hover:bg-yellow-300 transition-colors mb-8" %>
    <% end %>
    <%= link_to "← Volver a noticias", news_index_path, class: "text-yellow-500 font-semibold hover:underline" %>
  </div>
</section>
