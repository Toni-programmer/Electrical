<% content_for :title, "Electricistas en Valencia | Electricas Rincón" %>
<% content_for :meta_description, "Electricistas en Valencia con más de 10 años de experiencia. Instalaciones eléctricas, reformas y reparaciones para hogares y empresas en Valencia. Presupuesto gratuito." %>
<!-- Hero -->
<section class="relative min-h-[500px] flex items-stretch overflow-hidden">
  <%# Imagen de fondo completa %>
  <%= image_tag "hero-electrician.jpg",
        alt: "Electricista Rincón trabajando en cuadro eléctrico",
        class: "absolute inset-0 w-full h-full object-cover object-center" %>
  <%# Gradiente: amarillo sólido a la izquierda, se difumina hacia la derecha %>
  <div class="absolute inset-0 bg-gradient-to-r from-yellow-400 via-yellow-400/85 to-yellow-400/0" style="background: linear-gradient(to right, #facc15 0%, #facc15 38%, rgba(250,204,21,0.75) 55%, rgba(250,204,21,0) 80%);"></div>
  <%# Contenido de texto %>
  <div class="relative z-10 flex flex-col justify-center w-full md:w-1/2 px-8 md:px-16 py-20 bg-yellow-400/60 md:bg-transparent">
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight mb-4">
      Soluciones eléctricas<br>
      profesionales
    </h1>
    <p class="text-gray-800 text-lg mb-8 max-w-md">
      Instalaciones, reparaciones y mantenimiento eléctrico para hogares y empresas. Rápido, seguro y con garantía.
    </p>
    <div class="flex flex-wrap gap-4">
      <%= link_to "Solicitar presupuesto", new_quote_path,
            class: "bg-gray-900 text-yellow-400 font-semibold px-6 py-3 rounded-lg hover:bg-gray-700 transition-colors" %>
      <%= link_to "Ver servicios", services_path,
            class: "border-2 border-gray-900 text-gray-900 font-semibold px-6 py-3 rounded-lg hover:bg-yellow-300 transition-colors" %>
    </div>
  </div>
</section>
<!-- Highlights -->
<section class="py-6 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto flex items-center justify-center divide-x divide-gray-200">
    <div class="text-center px-4 md:px-8">
      <div class="text-yellow-400 text-2xl font-extrabold">+500</div>
      <p class="text-gray-600 text-sm font-medium">Proyectos completados</p>
    </div>
    <div class="text-center px-4 md:px-8">
      <div class="text-yellow-400 text-2xl font-extrabold">Eficiencia</div>
      <p class="text-gray-600 text-sm font-medium">Soluciones rápidas</p>
    </div>
    <div class="text-center px-4 md:px-8">
      <div class="text-yellow-400 text-2xl font-extrabold">10 años</div>
      <p class="text-gray-600 text-sm font-medium">De experiencia</p>
    </div>
  </div>
</section>
<!-- Servicios destacados -->
<% if @services.any? %>
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Nuestros servicios</h2>
      <p class="text-gray-500 mb-10">Todo lo que necesitas en instalaciones eléctricas.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <% @services.each do |service| %>
          <%= link_to service_path(service), class: "block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition-shadow group" do %>
            <% if service.image.present? %>
              <div class="h-48 sm:h-44 overflow-hidden">
                <%= image_tag service.image, alt: service.title, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
              </div>
            <% end %>
            <div class="p-5">
              <h3 class="font-bold text-lg text-gray-900 mb-2"><%= service.title %></h3>
              <p class="text-gray-500 text-sm mb-4 line-clamp-2"><%= service.description %></p>
              <span class="text-yellow-500 font-semibold text-sm">Ver más →</span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="text-center mt-10">
        <%= link_to "Ver todos los servicios", services_path,
            class: "border-2 border-yellow-400 text-gray-900 font-semibold px-6 py-3 rounded-lg hover:bg-yellow-400 transition-colors" %>
      </div>
    </div>
  </section>
<% end %>
<!-- Proyectos destacados -->
<% if @projects.any? %>
  <section class="py-16 px-6 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 mb-2">Proyectos recientes</h2>
      <p class="text-gray-500 mb-10">Algunos trabajos que hemos realizado.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% @projects.each do |project| %>
          <%= link_to project_path(project), class: "block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow" do %>
            <% if project.image.present? %>
              <%= image_tag project.image, alt: project.title, class: "w-full h-48 object-cover" %>
            <% else %>
              <div class="w-full h-48 bg-yellow-100 flex items-center justify-center">
                <svg class="h-16 w-16 text-yellow-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M13 2L4.09 12.96A1 1 0 005 14.5h6.5L11 22l8.91-10.96A1 1 0 0019 9.5h-6.5L13 2z"/>
                </svg>
              </div>
            <% end %>
            <div class="p-6">
              <p class="text-xs text-yellow-600 font-semibold uppercase mb-1"><%= project.client %></p>
              <h3 class="font-bold text-gray-900 mb-2"><%= project.title %></h3>
              <span class="text-yellow-500 font-semibold text-sm">Ver proyecto →</span>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="text-center mt-10">
        <%= link_to "Ver todos los proyectos", projects_path,
            class: "border-2 border-yellow-400 text-gray-900 font-semibold px-6 py-3 rounded-lg hover:bg-yellow-400 transition-colors" %>
      </div>
    </div>
  </section>
<% end %>
<!-- Testimonios -->
<section class="py-16 px-6 bg-white">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-gray-900 mb-2 text-center">Lo que dicen nuestros clientes</h2>
    <p class="text-gray-500 mb-10 text-center">Opiniones reales de Google</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <div class="bg-gray-50 rounded-xl p-4 shadow-sm">
        <div class="flex items-center gap-1 mb-2">
          <% 5.times do %><svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><% end %>
        </div>
        <p class="text-gray-700 text-sm leading-relaxed mb-3">"Trato inigualable, muy profesional y muy discreto, sin duda volveré a contar con él."</p>
        <p class="font-bold text-gray-900 text-xs">Carmen</p>
      </div>

      <div class="bg-gray-50 rounded-xl p-4 shadow-sm">
        <div class="flex items-center gap-1 mb-2">
          <% 5.times do %><svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><% end %>
        </div>
        <p class="text-gray-700 text-sm leading-relaxed mb-3">"Gran profesional, la instalación fue rápida y todo perfecto. Muy recomendable."</p>
        <p class="font-bold text-gray-900 text-xs">David Collado Vidal</p>
      </div>

      <div class="bg-gray-50 rounded-xl p-4 shadow-sm">
        <div class="flex items-center gap-1 mb-2">
          <% 5.times do %><svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><% end %>
        </div>
        <p class="text-gray-700 text-sm leading-relaxed mb-3">"Un gran profesional. Me ayudó en todo mi proyecto y me asesoró en cada punto. Muy contento con la rapidez y el resultado."</p>
        <p class="font-bold text-gray-900 text-xs">Miquel J</p>
      </div>

      <div class="bg-gray-50 rounded-xl p-4 shadow-sm">
        <div class="flex items-center gap-1 mb-2">
          <% 5.times do %><svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><% end %>
        </div>
        <p class="text-gray-700 text-sm leading-relaxed mb-3">"Buen profesional, rápido y efectivo. Te ayuda y asesora en lo que necesites. Totalmente recomendable."</p>
        <p class="font-bold text-gray-900 text-xs">Carlos Martinez Vidal</p>
      </div>

    </div>
  </div>
</section>
<!-- Logos colaboradores, proveedores y entidades -->
<section class="py-8 px-6 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto space-y-8">
    <div>
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Empresas con las que colaboramos</p>
      <div class="flex flex-wrap md:flex-nowrap items-center justify-center gap-6 md:gap-12">
        <%= image_tag "logo-arkima.png", alt: "Arkima", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
        <%= image_tag "logo-promurban.png", alt: "Promurban", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
        <%= image_tag "logo-consnaval.jpg", alt: "Consnaval", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      </div>
    </div>
    <div class="border-t border-gray-100 pt-8">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Proveedores que colaboran con nosotros</p>
      <div class="flex flex-wrap md:flex-nowrap items-center justify-center gap-6 md:gap-12">
        <%= image_tag "logo-sindel.jpg", alt: "Sindel materiales eléctricos", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
        <%= image_tag "logo-volton.jpg", alt: "Volton", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
        <%= image_tag "logo-fermax.svg", alt: "Fermax", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
        <%= image_tag "logo-obramat.png", alt: "Obramat", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      </div>
    </div>
    <div class="border-t border-gray-100 pt-8">
      <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Entidades oficiales</p>
      <div class="flex flex-wrap items-center justify-center gap-12">
        <%= image_tag "logo-comunitat.png", alt: "Comunidad Valenciana", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      </div>
    </div>
  </div>
</section>
<!-- CTA final -->
<section class="py-20 px-6 bg-gray-900">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-white">¿Necesitas un electricista?</h2>
      <p class="text-gray-400 text-sm mt-1">Presupuesto sin compromiso en menos de 24 horas.</p>
    </div>
    <%= link_to "Solicitar presupuesto", new_quote_path,
        class: "shrink-0 bg-yellow-400 text-gray-900 font-bold px-6 py-3 rounded-lg hover:bg-yellow-300 transition-colors" %>
  </div>
</section>
