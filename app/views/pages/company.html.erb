<% content_for :title, "Quiénes somos | Electricistas en Valencia – Electricas Rincón" %>
<% content_for :meta_description, "Empresa familiar de electricistas en Valencia con más de 10 años de experiencia. Instalaciones certificadas por la Comunitat Valenciana." %>
<section class="relative min-h-[400px] flex items-stretch overflow-hidden">
  <%= photo_tag "hero-electrician.jpg",
        alt: "Electricista Rincón trabajando en cuadro eléctrico",
        class: "absolute inset-0 w-full h-full object-cover object-center" %>
  <div class="absolute inset-0" style="background: linear-gradient(to right, #facc15 0%, #facc15 38%, rgba(250,204,21,0.75) 55%, rgba(250,204,21,0) 80%);"></div>
  <div class="relative z-10 flex flex-col justify-center w-full md:w-1/2 px-8 md:px-16 py-20 bg-yellow-400/70 md:bg-transparent">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Electricistas en Valencia — Electricas Rincón</h1>
    <p class="text-gray-800 text-lg max-w-2xl">Conoce al equipo detrás de tu empresa de electricidad de confianza en Valencia.</p>
  </div>
</section>
<section class="py-16 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Quiénes somos</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        Electricas Rincón es una empresa familiar con más de 10 años de experiencia en instalaciones y mantenimiento eléctrico. Trabajamos tanto para particulares como para empresas, siempre con la máxima calidad y seguridad.
      </p>
      <p class="text-gray-600 leading-relaxed mb-4">
        Nuestro equipo está formado por electricistas certificados, comprometidos con ofrecer un servicio rápido, profesional y al mejor precio.
      </p>
      <p class="text-gray-600 leading-relaxed">
        Optimizamos cada proyecto para lograr resultados rápidos y precisos.
      </p>
    </div>
    <div class="relative rounded-2xl overflow-hidden h-80 md:h-96">
      <%= photo_tag "hero-electrician.jpg",
          alt: "Electricista Rincón trabajando en cuadro eléctrico",
          loading: "lazy",
          class: "w-full h-full object-cover object-center" %>
      <div class="absolute inset-0 hidden md:block" style="background: linear-gradient(to right, #ffffff 0%, rgba(255,255,255,0.5) 30%, rgba(255,255,255,0) 60%);"></div>
    </div>
  </div>
</section>
<section class="py-16 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
    <div class="bg-white rounded-xl p-8 shadow-sm">
      <div class="text-yellow-400 text-4xl font-extrabold mb-2">+500</div>
      <p class="text-gray-700 font-medium">Proyectos completados</p>
    </div>
    <div class="bg-white rounded-xl p-8 shadow-sm">
      <div class="text-yellow-400 text-4xl font-extrabold mb-2">24h</div>
      <p class="text-gray-700 font-medium">Respuesta garantizada en menos de 24 horas.</p>
    </div>
    <div class="bg-white rounded-xl p-8 shadow-sm">
      <div class="text-yellow-400 text-4xl font-extrabold mb-2">+10 años</div>
      <p class="text-gray-700 font-medium">De experiencia</p>
    </div>
  </div>
</section>
<section class="py-16 px-6 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Empresas con las que colaboramos</p>
    <div class="flex flex-wrap md:flex-nowrap items-center justify-center gap-6 md:gap-16">
      <%= image_tag "logo-arkima.png", alt: "Arkima", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      <%= image_tag "logo-promurban.png", alt: "Promurban", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      <%= image_tag "logo-consnaval.jpg", alt: "Consnaval", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
    </div>
  </div>
</section>
<section class="py-10 px-6 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Proveedores que colaboran con nosotros</p>
    <div class="flex flex-wrap md:flex-nowrap items-center justify-center gap-6 md:gap-12">
      <%= image_tag "logo-sindel.jpg", alt: "Sindel materiales eléctricos", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      <%= image_tag "logo-volton.jpg", alt: "Volton", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      <%= image_tag "logo-fermax.svg", alt: "Fermax", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
      <%= image_tag "logo-obramat.png", alt: "Obramat", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
    </div>
  </div>
</section>
<section class="py-10 px-6 bg-white border-y border-gray-100">
  <div class="max-w-6xl mx-auto">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Entidades oficiales</p>
    <div class="flex flex-wrap items-center justify-center gap-12">
      <%= image_tag "logo-comunitat.png", alt: "Comunidad Valenciana", loading: "lazy", class: "h-14 w-32 md:h-[120px] md:w-[352px] object-contain" %>
    </div>
  </div>
</section>
  <section class="py-20 px-6 bg-gray-900 text-center">
    <h2 class="text-3xl font-bold text-white mb-4">¿Hablamos?</h2>
    <p class="text-gray-400 mb-8 max-w-xl mx-auto">Solicita tu presupuesto sin compromiso.</p>
    <%= link_to "Solicitar presupuesto", new_quote_path,
        class: "bg-yellow-400 text-gray-900 font-bold px-8 py-4 rounded-lg text-lg hover:bg-yellow-300 transition-colors" %>
  </section>
