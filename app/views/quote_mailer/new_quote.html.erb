<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; color: #1f2937; background: #f9fafb; margin: 0; padding: 0; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb; }
    .header { background: #111827; padding: 24px 32px; }
    .header h1 { color: #facc15; margin: 0; font-size: 20px; }
    .header p { color: #9ca3af; margin: 4px 0 0; font-size: 14px; }
    .body { padding: 32px; }
    .section { margin-bottom: 28px; }
    .section h2 { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; margin-bottom: 14px; }
    .row { margin-bottom: 8px; font-size: 14px; }
    .label { color: #6b7280; }
    .value { color: #111827; font-weight: 600; }
    .footer { background: #f3f4f6; padding: 16px 32px; text-align: center; font-size: 12px; color: #9ca3af; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Nuevo presupuesto recibido</h1>
      <p>Electricas Rincón – <%= Time.current.strftime("%d/%m/%Y %H:%M") %></p>
    </div>
    <div class="body">
      <div class="section">
        <h2>Datos de contacto</h2>
        <div class="row"><span class="label">Nombre: </span><span class="value"><%= @quote.name %></span></div>
        <div class="row"><span class="label">Teléfono: </span><span class="value"><%= @quote.phone %></span></div>
        <div class="row"><span class="label">Email: </span><span class="value"><%= @quote.email %></span></div>
      </div>
      <div class="section">
        <h2>Ubicación</h2>
        <div class="row"><span class="label">Provincia: </span><span class="value"><%= @quote.provincia %></span></div>
        <div class="row"><span class="label">Ciudad: </span><span class="value"><%= @quote.ciudad %></span></div>
        <div class="row"><span class="label">Código postal: </span><span class="value"><%= @quote.codigo_postal %></span></div>
      </div>
      <div class="section">
        <h2>Detalles de la instalación</h2>
        <div class="row"><span class="label">Título: </span><span class="value"><%= @quote.titulo %></span></div>
        <div class="row"><span class="label">Suministro eléctrico: </span><span class="value"><%= @quote.suministro_electrico %></span></div>
        <div class="row"><span class="label">Tipo de alimentación: </span><span class="value"><%= @quote.tipo_alimentacion %></span></div>
        <div class="row"><span class="label">Tipo de vivienda: </span><span class="value"><%= @quote.tipo_vivienda %><%= " – #{@quote.tipo_vivienda_otro}" if @quote.tipo_vivienda_otro.present? %></span></div>
        <div class="row"><span class="label">Superficie: </span><span class="value"><%= @quote.superficie %></span></div>
        <div class="row"><span class="label">Puntos de luz: </span><span class="value"><%= @quote.puntos_de_luz %></span></div>
        <div class="row"><span class="label">Tipo de reforma: </span><span class="value"><%= @quote.tipo_reforma %><%= " – #{@quote.tipo_reforma_otro}" if @quote.tipo_reforma_otro.present? %></span></div>
      </div>
    </div>
    <div class="footer">
      Email generado automáticamente por electricasrinconvlc.es
    </div>
  </div>
</body>
</html>