      "url": "https://electricasrinconvlc.es",
      "telephone": "+34622577356",
      "email": "electricasrincon@gmail.com",
      "description": "Electricistas en Valencia con más de 10 años de experiencia en instalaciones, reformas y reparaciones eléctricas para hogares y empresas.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "C/ Ingeniero José Sirera 26-22",
        "addressLocality": "Valencia",
        "postalCode": "46017",
        "addressRegion": "Comunitat Valenciana",
        "addressCountry": "ES"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 39.4561,
        "longitude": -0.3531
