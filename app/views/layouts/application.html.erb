<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Electricas Rincón" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Electricas Rincón">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-white text-gray-800 flex flex-col min-h-screen">
    <!-- Navbar -->
    <header class="bg-gray-900 shadow-md fixed top-0 left-0 w-full z-50">
      <div class="max-w-6xl mx-auto px-6 flex items-center">
        <!-- Logo izquierda -->
        <%= link_to root_path, class: "flex items-center gap-3 shrink-0" do %>
          <%= image_tag "logo.png", alt: "Instalaciones Electricas Rincón", class: "h-28 w-auto invert" %>
          <div class="w-px h-10 bg-gray-500"></div>
          <span class="leading-tight tracking-wide uppercase text-sm font-bold">
            <span class="text-gray-300">Instalaciones<br>
              Eléctricas</span><br>
            <span class="text-yellow-400 text-base">Rincón</span>
          </span>
        <% end %>
        <!-- Nav central -->
        <nav class="hidden md:flex flex-1 justify-center items-center gap-6 text-white font-medium">
          <%= link_to "Inicio", root_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Servicios", services_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Proyectos", projects_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Noticias", news_index_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Nosotros", pages_company_path, class: "hover:text-yellow-400 transition-colors" %>
        </nav>
        <!-- Botón derecha + mobile toggle -->
        <div class="flex items-center gap-3 shrink-0 ml-auto md:ml-0">
          <%= link_to "Solicitar Presupuesto", new_quote_path,
                class: "hidden md:inline-block bg-yellow-400 text-gray-900 px-4 py-2 rounded-lg hover:bg-yellow-300 transition-colors font-medium" %>
          <button id="menu-btn" class="md:hidden text-white focus:outline-none">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
      <!-- Mobile nav -->
      <nav id="mobile-menu" class="hidden md:hidden bg-gray-800 border-t border-gray-700 px-6 pb-4 flex flex-col gap-3 text-white font-medium">
        <%= link_to "Inicio", root_path, class: "hover:text-yellow-400" %>
        <%= link_to "Servicios", services_path, class: "hover:text-yellow-400" %>
        <%= link_to "Proyectos", projects_path, class: "hover:text-yellow-400" %>
        <%= link_to "Noticias", news_index_path, class: "hover:text-yellow-400" %>
        <%= link_to "Nosotros", pages_company_path, class: "hover:text-yellow-400" %>
        <%= link_to "Solicitar Presupuesto", new_quote_path, class: "hover:text-yellow-400" %>
      </nav>
    </header>
    <!-- Flash messages -->
    <% if notice %>
      <div class="mx-auto max-w-6xl w-full px-6 pt-4">
        <div class="bg-green-100 border border-green-400 text-green-800 px-4 py-3 rounded">
          <%= notice %>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="mx-auto max-w-6xl w-full px-6 pt-4">
        <div class="bg-red-100 border border-red-400 text-red-800 px-4 py-3 rounded">
          <%= alert %>
        </div>
      </div>
    <% end %>
    <!-- Trust bar -->
    <div class="bg-white text-gray-700 text-sm px-6 border-b border-gray-200 pt-28 py-4">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-x-8 gap-y-2 mt-4">
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-yellow-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Presupuestos gratuitos
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-yellow-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Tarifas transparentes
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-yellow-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Certificados por la  Comunidad Valenciana
        </span>
        <span class="flex items-center gap-1">
          <% 5.times do %>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          <% end %>
          <span class="ml-1 font-semibold">5/5</span>
        </span>
        <a href="tel:622577356" class="flex items-center gap-1.5 text-yellow-500 font-semibold hover:text-yellow-600 transition-colors">
          <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Llámanos al 622 577 356
        </a>
      </div>
    </div>
    <!-- Main content -->
    <main class="flex-1">
      <%= yield %>
    </main>
    <!-- Footer -->
    <footer class="bg-gray-900 text-gray-300 mt-16">
      <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <%= image_tag "logo.png", alt: "Instalaciones Electricas Rincón", class: "h-16 w-auto invert" %>
            <div class="w-px h-10 bg-gray-500"></div>
            <span class="leading-tight tracking-wide uppercase text-sm font-bold">
              <span class="text-gray-300">Instalaciones<br>
                Eléctricas</span><br>
              <span class="text-yellow-400 text-base">Rincón</span>
            </span>
          </div>
          <p class="text-sm leading-relaxed">Soluciones eléctricas profesionales para hogares y empresas. Calidad, seguridad y confianza.</p>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-4">Enlaces</h3>
          <ul class="space-y-2 text-sm">
            <li><%= link_to "Servicios", services_path, class: "hover:text-yellow-400 transition-colors" %></li>
            <li><%= link_to "Proyectos", projects_path, class: "hover:text-yellow-400 transition-colors" %></li>
            <li><%= link_to "Noticias", news_index_path, class: "hover:text-yellow-400 transition-colors" %></li>
            <li><%= link_to "Nosotros", pages_company_path, class: "hover:text-yellow-400 transition-colors" %></li>
          </ul>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-4">Contacto</h3>
          <ul class="space-y-2 text-sm">
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>+34 622 577 356 </span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>oscar@electricasrincon.com</span>
            </li>
          </ul>
          <%= link_to "Solicitar Presupuesto", new_quote_path,
                class: "mt-4 inline-block bg-yellow-400 text-gray-900 font-semibold px-4 py-2 rounded-lg hover:bg-yellow-300 transition-colors text-sm" %>
        </div>
      </div>
      <div class="border-t border-gray-700 text-center text-sm py-4 text-gray-500">
        &copy; <%= Date.current.year %> Electricas Rincón. Todos los derechos reservados.
      </div>
    </footer>
    <script>
      document.getElementById('menu-btn').addEventListener('click', function() {
        document.getElementById('mobile-menu').classList.toggle('hidden');
      });
    </script>
  </body>
</html>
