  <body class="bg-white text-gray-800 flex flex-col min-h-screen">
    <!-- Navbar -->
    <header class="bg-gray-900 shadow-md fixed top-0 left-0 w-full z-50">
      <div class="max-w-6xl mx-auto px-6 flex items-center">
        <!-- Logo izquierda -->
        <%= link_to root_path, class: "flex items-center gap-3 shrink-0" do %>
          <%= image_tag "logo.png", alt: "Instalaciones Electricas Rincón", class: "h-28 w-auto invert" %>
          <div class="w-px h-10 bg-gray-500"></div>
          <span class="leading-tight tracking-wide uppercase text-sm font-bold">
            <span class="text-gray-300">Instalaciones<br>
              Eléctricas</span><br>
            <span class="text-yellow-400 text-base">Rincón</span>
          </span>
        <% end %>
        <!-- Nav central -->
        <nav class="hidden md:flex flex-1 justify-center items-center gap-6 text-white font-medium">
          <%= link_to "Inicio", root_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Servicios", services_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Proyectos", projects_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Noticias", news_index_path, class: "hover:text-yellow-400 transition-colors" %>
          <%= link_to "Nosotros", pages_company_path, class: "hover:text-yellow-400 transition-colors" %>
        </nav>
        <!-- Botón derecha + mobile toggle -->
        <div class="flex items-center gap-3 shrink-0 ml-auto md:ml-0">
          <%= link_to "Solicitar Presupuesto", new_quote_path,
                class: "hidden md:inline-block bg-yellow-400 text-gray-900 px-4 py-2 rounded-lg hover:bg-yellow-300 transition-colors font-medium" %>
