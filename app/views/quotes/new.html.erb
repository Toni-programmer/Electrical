<% content_for :title, "Presupuesto electricista en Valencia – Electricas Rincón" %>

<section class="relative min-h-[260px] flex items-stretch overflow-hidden">
  <%= image_tag "hero-electrician.jpg",
        alt: "Electricista en Valencia trabajando",
        class: "absolute inset-0 w-full h-full object-cover object-center" %>
  <div class="absolute inset-0" style="background: linear-gradient(to right, #facc15 0%, #facc15 38%, rgba(250,204,21,0.75) 55%, rgba(250,204,21,0) 80%);"></div>
  <div class="relative z-10 flex flex-col justify-center w-full md:w-1/2 px-8 md:px-16 py-16 bg-yellow-400/70 md:bg-transparent">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Presupuesto electricista en Valencia</h1>
    <p class="text-gray-800 text-lg max-w-2xl">Cuéntanos qué necesitas y te respondemos en menos de 24 horas. Sin compromiso.</p>
  </div>
</section>

<section class="py-16 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">

    <!-- Formulario -->
    <div class="md:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Datos de contacto</h2>
      <%= render "form", quote: @quote %>
    </div>

    <!-- Info lateral -->
    <div class="space-y-6">
      <div class="bg-gray-900 rounded-2xl p-6 text-white">
        <h3 class="font-bold text-lg mb-4">¿Por qué elegirnos?</h3>
        <ul class="space-y-3 text-sm text-gray-300">
          <li class="flex items-start gap-2">
            <svg class="h-4 w-4 text-yellow-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Presupuesto gratuito y sin compromiso
          </li>
          <li class="flex items-start gap-2">
            <svg class="h-4 w-4 text-yellow-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Respuesta en menos de 24 horas
          </li>
          <li class="flex items-start gap-2">
            <svg class="h-4 w-4 text-yellow-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Electricistas certificados y con experiencia
          </li>
          <li class="flex items-start gap-2">
            <svg class="h-4 w-4 text-yellow-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Tarifas transparentes sin letra pequeña
          </li>
        </ul>
      </div>

      <div class="bg-yellow-50 rounded-2xl p-6 border border-yellow-200">
        <h3 class="font-bold text-gray-900 mb-3">Prefiero llamar</h3>
        <a href="tel:622577356" class="flex items-center gap-2 text-gray-800 font-bold text-lg hover:text-yellow-600 transition-colors">
          <svg class="h-5 w-5 text-yellow-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          622 577 356
        </a>
        <p class="text-gray-500 text-sm mt-2">Lunes a viernes, 8h – 18h</p>
      </div>
    </div>

  </div>
</section>
