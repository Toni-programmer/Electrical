<%= form_with(model: quote, class: "space-y-6", id: "quote-form") do |form| %>
  <%= invisible_captcha %>
  <% if quote.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <p class="text-red-700 font-semibold mb-2">Por favor corrige los siguientes errores:</p>
      <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
        <% quote.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Indicador de pasos -->
  <div class="flex items-center justify-between mb-8">
    <% [["1", "Contacto y ubicación"], ["2", "Instalación"], ["3", "Email"]].each_with_index do |(num, label), i| %>
      <div class="flex items-center <%= i < 2 ? 'flex-1' : '' %>">
        <div class="flex flex-col items-center">
          <div id="step-indicator-<%= num %>" class="h-9 w-9 rounded-full flex items-center justify-center text-sm font-bold transition-colors
            <%= num == '1' ? 'bg-yellow-400 text-gray-900' : 'bg-gray-200 text-gray-500' %>">
            <%= num %>
          </div>
          <span class="text-xs font-medium mt-1 <%= num == '1' ? 'text-gray-900' : 'text-gray-400' %>" id="step-label-<%= num %>"><%= label %></span>
        </div>
        <% if i < 2 %>
          <div class="flex-1 h-0.5 mx-3 mt-[-18px]" id="step-line-<%= num %>">
            <div class="h-full bg-gray-200 rounded"></div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- PASO 1: Ubicación -->
  <div id="step-1" class="space-y-6">
    <h3 class="text-lg font-bold text-gray-800 border-b border-gray-100 pb-3">Ubicación del trabajo</h3>
    <div>
      <%= form.label :name, "Nombre completo", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :name, placeholder: "Tu nombre",
          required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :phone, "Teléfono", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :phone, placeholder: "6XX XXX XXX",
          required: true, pattern: "^(\\+34|0034)?[6789]\\d{8}$", title: "Introduce un teléfono válido (9 dígitos, ej: 612345678)",
          class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :provincia, "Provincia", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :provincia, placeholder: "Ej: Valencia",
          required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :ciudad, "Ciudad", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :ciudad, placeholder: "Ej: Valencia",
          required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div>
      <%= form.label :codigo_postal, "Código postal", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :codigo_postal, placeholder: "Ej: 46001",
          required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div class="flex justify-end pt-2">
      <button type="button" onclick="goToStep(2)"
        class="bg-yellow-400 text-gray-900 font-bold px-8 py-3 rounded-lg hover:bg-yellow-300 transition-colors">
        Siguiente →
      </button>
    </div>
  </div>

  <!-- PASO 2: Instalación -->
  <div id="step-2" class="space-y-6 hidden">
    <h3 class="text-lg font-bold text-gray-800 border-b border-gray-100 pb-3">Detalles de la instalación</h3>
    <div>
      <%= form.label :titulo, "Título o detalle de la reforma/instalación", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :titulo, placeholder: "Ej: Instalación eléctrica completa en piso",
          required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :suministro_electrico, "¿Tienes suministro eléctrico?", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.select :suministro_electrico, [["Selecciona una opción", ""], ["Sí", "si"], ["No", "no"]],
            {},
            required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :tipo_alimentacion, "Tipo de alimentación (tensión)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.select :tipo_alimentacion, [["Selecciona una opción", ""], ["Monofásica 230V", "monofasica_230v"], ["Trifásica 400V", "trifasica_400v"]],
            {},
            required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
      </div>
    </div>
    <div>
      <%= form.label :tipo_vivienda, "Tipo de vivienda", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.select :tipo_vivienda, [["Selecciona una opción", ""], ["Apartamento", "apartamento"], ["Vivienda unifamiliar", "vivienda_unifamiliar"], ["Local comercial", "local_comercial"], ["Otros", "otros"]],
          {},
          { required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent",
            onchange: "toggleOtros(this, 'tipo_vivienda_otro_container')" } %>
      <div id="tipo_vivienda_otro_container" class="mt-2 hidden">
        <%= form.text_area :tipo_vivienda_otro, rows: 2, placeholder: "Especifica el tipo de vivienda...",
            class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent resize-none" %>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :superficie, "Superficie (m²)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.text_field :superficie, placeholder: "Ej: 85 m²",
            required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
      </div>
      <div>
        <%= form.label :puntos_de_luz, "Puntos de luz", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.text_field :puntos_de_luz, placeholder: "Ej: 12 puntos",
            required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
      </div>
    </div>
    <div>
      <%= form.label :tipo_reforma, "Tipo de reforma", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.select :tipo_reforma, [["Selecciona una opción", ""], ["Integral", "integral"], ["Parcial", "parcial"], ["Otros", "otros"]],
          {},
          { required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent",
            onchange: "toggleOtros(this, 'tipo_reforma_otro_container')" } %>
      <div id="tipo_reforma_otro_container" class="mt-2 hidden">
        <%= form.text_area :tipo_reforma_otro, rows: 2, placeholder: "Especifica el tipo de reforma...",
            class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent resize-none" %>
      </div>
    </div>
    <div class="flex justify-between pt-2">
      <button type="button" onclick="goToStep(1)"
        class="border-2 border-gray-300 text-gray-600 font-bold px-8 py-3 rounded-lg hover:bg-gray-50 transition-colors">
        ← Anterior
      </button>
      <button type="button" onclick="goToStep(3)"
        class="bg-yellow-400 text-gray-900 font-bold px-8 py-3 rounded-lg hover:bg-yellow-300 transition-colors">
        Siguiente →
      </button>
    </div>
  </div>

  <!-- PASO 3: Contacto -->
  <div id="step-3" class="space-y-6 hidden">
    <h3 class="text-lg font-bold text-gray-800 border-b border-gray-100 pb-3">Datos de contacto</h3>
    <div>
      <%= form.label :email, "Correo electrónico", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.email_field :email, placeholder: "tu@email.com",
          required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:border-transparent" %>
    </div>
    <div class="flex justify-between pt-2">
      <button type="button" onclick="goToStep(2)"
        class="border-2 border-gray-300 text-gray-600 font-bold px-8 py-3 rounded-lg hover:bg-gray-50 transition-colors">
        ← Anterior
      </button>
      <%= form.submit "Enviar solicitud",
          class: "bg-yellow-400 text-gray-900 font-bold px-8 py-3 rounded-lg hover:bg-yellow-300 transition-colors cursor-pointer" %>
    </div>
  </div>
<% end %>

<script>
  function validateStep(stepNum) {
    var step = document.getElementById('step-' + stepNum);
    var fields = step.querySelectorAll('input[required], select[required], textarea[required]');
    var valid = true;

    fields.forEach(function(field) {
      field.classList.remove('border-red-500', 'ring-2', 'ring-red-400');
      var existing = field.parentNode.querySelector('.field-error');
      if (existing) existing.remove();

      var isEmpty = !field.value.trim();
      var patternInvalid = field.pattern && !new RegExp(field.pattern).test(field.value.trim());
      var label = step.querySelector('label[for="' + field.id + '"]');
      var fieldName = label ? label.textContent.trim() : 'Este campo';

      if (isEmpty || patternInvalid) {
        field.classList.add('border-red-500', 'ring-2', 'ring-red-400');
        var error = document.createElement('p');
        error.className = 'field-error text-red-500 text-xs mt-1 font-medium';
        error.textContent = isEmpty ? fieldName + ' es obligatorio' : 'Introduce un teléfono válido (ej: 612345678)';
        field.parentNode.insertBefore(error, field.nextSibling);
        valid = false;
      }
    });

    return valid;
  }

  function goToStep(targetStep) {
    var currentStep = null;
    [1, 2, 3].forEach(function(s) {
      if (!document.getElementById('step-' + s).classList.contains('hidden')) currentStep = s;
    });

    if (targetStep > currentStep && !validateStep(currentStep)) return;

    [1, 2, 3].forEach(function(s) {
      document.getElementById('step-' + s).classList.add('hidden');
      var indicator = document.getElementById('step-indicator-' + s);
      var label = document.getElementById('step-label-' + s);
      indicator.className = indicator.className.replace('bg-yellow-400 text-gray-900', 'bg-gray-200 text-gray-500');
      label.className = label.className.replace('text-gray-900', 'text-gray-400');
    });

    document.getElementById('step-' + targetStep).classList.remove('hidden');
    var activeIndicator = document.getElementById('step-indicator-' + targetStep);
    var activeLabel = document.getElementById('step-label-' + targetStep);
    activeIndicator.className = activeIndicator.className.replace('bg-gray-200 text-gray-500', 'bg-yellow-400 text-gray-900');
    activeLabel.className = activeLabel.className.replace('text-gray-400', 'text-gray-900');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function toggleOtros(select, containerId) {
    var container = document.getElementById(containerId);
    if (select.value === 'otros') {
      container.classList.remove('hidden');
    } else {
      container.classList.add('hidden');
    }
  }
</script>
