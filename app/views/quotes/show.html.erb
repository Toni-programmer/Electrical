<% content_for :title, "Solicitud recibida – Electricas Rincón" %>

<section class="py-24 px-6 flex items-center justify-center min-h-[60vh]">
  <div class="max-w-xl mx-auto text-center">
    <div class="h-20 w-20 bg-yellow-400 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="h-10 w-10 text-gray-900" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <h1 class="text-3xl font-extrabold text-gray-900 mb-4">¡Solicitud recibida!</h1>
    <p class="text-gray-600 text-lg mb-2">Gracias, <strong><%= @quote.name %></strong>.</p>
    <p class="text-gray-500 mb-8">Nos pondremos en contacto contigo en menos de 24 horas en el teléfono <strong><%= @quote.phone %></strong> o por email a <strong><%= @quote.email %></strong>.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Volver al inicio", root_path,
          class: "bg-yellow-400 text-gray-900 font-bold px-6 py-3 rounded-lg hover:bg-yellow-300 transition-colors" %>
      <%= link_to "Ver nuestros servicios", services_path,
          class: "border-2 border-gray-900 text-gray-900 font-bold px-6 py-3 rounded-lg hover:bg-gray-900 hover:text-white transition-colors" %>
    </div>
  </div>
</section>
