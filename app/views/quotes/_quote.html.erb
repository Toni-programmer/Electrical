<div id="<%= dom_id quote %>">
  <div>
    <strong>Name:</strong>
    <%= quote.name %>
  </div>

  <div>
    <strong>Phone:</strong>
    <%= quote.phone %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= quote.email %>
  </div>

  <div>
    <strong>Message:</strong>
    <%= quote.message %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= quote.status %>
  </div>

</div>
