<%= form_with(model: project, class: "space-y-6") do |form| %>
  <% if project.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <p class="text-red-700 font-semibold mb-2">Corrige los siguientes errores:</p>
      <ul class="list-disc list-inside text-red-600 text-sm space-y-1">
        <% project.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :title, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>
  <div>
    <%= form.label :slug, "Slug (URL)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :slug, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= form.label :client, "Cliente", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :client, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>
    <div>
      <%= form.label :category, "Categoría", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= form.text_field :category, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>
  </div>
  <div>
    <%= form.label :description, "Descripción", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400 resize-none" %>
  </div>
  <div>
    <%= form.label :image, "Imagen de portada (nombre de archivo o URL)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_field :image, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>
  <div>
    <%= form.label :gallery, "Galería (nombres separados por comas)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= form.text_area :gallery, rows: 3, class: "w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-400 resize-none" %>
  </div>
  <div class="flex gap-4 pt-2">
    <%= form.submit project.new_record? ? "Crear proyecto" : "Guardar cambios",
        class: "bg-yellow-400 text-gray-900 font-bold px-8 py-3 rounded-lg hover:bg-yellow-300 transition-colors cursor-pointer" %>
    <%= link_to "Cancelar", projects_path, class: "border-2 border-gray-200 text-gray-600 font-bold px-8 py-3 rounded-lg hover:bg-gray-50 transition-colors" %>
  </div>
<% end %>
