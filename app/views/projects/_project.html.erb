<%= link_to project_path(project), id: dom_id(project), class: "block bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow" do %>
  <% if project.image.present? %>
    <%= photo_tag project.image, alt: project.title, loading: "lazy", class: "w-full h-48 object-cover" %>
  <% end %>
  <div class="p-6">
    <% if project.category.present? %>
      <span class="text-xs font-bold uppercase tracking-wider text-yellow-600"><%= project.category %></span>
    <% end %>
    <h2 class="font-bold text-gray-900 text-lg mt-1 mb-2"><%= project.title %></h2>
    <p class="text-gray-500 text-sm line-clamp-2 mb-4"><%= project.description %></p>
    <span class="text-yellow-500 font-semibold text-sm">Ver proyecto →</span>
  </div>
<% end %>
