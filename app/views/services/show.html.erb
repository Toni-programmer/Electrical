<% content_for :title, seo_title(@service.title) %>
<% content_for :meta_description, "#{@service.description.truncate(155)}" %>
<% content_for :og_image, @service.image if @service.image.present? %>
<% content_for :og_image_alt, @service.title %>

<!-- Header -->
<section class="bg-gray-900 py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <%= link_to "← Volver a servicios", services_path, class: "text-yellow-400 text-sm font-medium hover:text-yellow-300 transition-colors mb-6 inline-block" %>
    <div class="flex items-center gap-4 mt-2">
      <div class="h-14 w-14 bg-yellow-400 rounded-xl flex items-center justify-center shrink-0">
        <svg class="h-7 w-7 text-gray-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <h1 class="text-4xl font-extrabold text-white"><%= @service.title %></h1>
    </div>
  </div>
</section>

<!-- Contenido -->
<section class="py-16 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="md:col-span-2">
      <% if @service.image.present? %>
        <%= image_tag @service.image, alt: @service.title, loading: "lazy", class: "w-full h-64 object-cover rounded-2xl mb-8 shadow-md" %>
      <% end %>
      <p class="text-gray-600 text-lg leading-relaxed"><%= @service.description %></p>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <div class="bg-yellow-400 rounded-2xl p-6">
        <h3 class="font-bold text-gray-900 text-lg mb-2">¿Te interesa este servicio?</h3>
        <p class="text-gray-800 text-sm mb-4">Solicita un presupuesto gratuito sin compromiso.</p>
        <%= link_to "Pedir presupuesto", new_quote_path,
              class: "block text-center bg-gray-900 text-yellow-400 font-semibold px-4 py-3 rounded-lg hover:bg-gray-700 transition-colors" %>
      </div>

      <div class="bg-gray-50 rounded-2xl p-6">
        <h3 class="font-bold text-gray-900 mb-3">Llámanos directamente</h3>
        <a href="tel:622577356" class="flex items-center gap-2 text-gray-700 font-semibold hover:text-yellow-500 transition-colors">
          <svg class="h-5 w-5 text-yellow-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          622 577 356
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Otros servicios -->
<section class="py-16 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Otros servicios</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% Service.where.not(id: @service.id).limit(3).each do |s| %>
        <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow border border-gray-100">
          <h3 class="font-bold text-gray-900 mb-2"><%= s.title %></h3>
          <p class="text-gray-500 text-sm mb-4 line-clamp-2"><%= s.description %></p>
          <%= link_to "Ver más →", service_path(s), class: "text-yellow-500 font-semibold text-sm hover:text-yellow-600" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
